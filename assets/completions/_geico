(( $+functions[_geico_commands] )) ||
_geico_commands() {
    local commands; commands=(
'add:Register an executable and integrate it into the desktop and PATH' \
'list:List all managed applications with health checks' \
'show:Show detailed information and paths for a registered application' \
'update:Update metadata, target executable, icon, or categories of a registered application' \
'remove:Safely remove desktop launcher and symlink (preserves original executable)' \
'completions:Generate shell completion script (bash, zsh, fish, elvish, powershell)' \
'health:Check system environment and desktop integration health' \
'doctor:Audit and auto-repair broken symlinks, orphaned desktop files, and sandbox configuration' \
'run:Launch a registered application in the background' \
'watch:Scan and optionally monitor directories for AppImages' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'geico commands' commands "$@"
}
